{
  "id": "/",
  "name": "Offline Media Player",
  "short_name": "Player",
  "description": "An offline audio and video player with a 10-band equalizer, playlists, YouTube and link playback.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f0f0f0",
  "theme_color": "#ffffff",
  "lang": "en",
  "dir": "ltr",
  "categories": ["music", "entertainment", "multimedia"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Scan for media",
      "short_name": "Scan",
      "description": "Find music and videos on this device",
      "url": "/?action=scan",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "screenshots": [
    { "src": "screenshot-1.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Player with playlist and controls" },
    { "src": "screenshot-2.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "10-band equalizer with presets" }
  ]
